{
  "manifest": 1,
  "id": "usage",
  "package": "kiosko-plugin-usage",
  "name": {
    "en": "AI usage",
    "es": "Consumo de IA",
    "de": "KI-Nutzung",
    "zh-Hant": "AI 用量",
    "zh-Hans": "AI 用量"
  },
  "version": "0.2.3",
  "description": {
    "en": "How much Claude Code you are burning, from ccusage: limit windows or spend, tokens by model, spend per block.",
    "es": "Cuánto Claude Code estás gastando, según ccusage: ventanas de límite o gasto, tokens por modelo y gasto por bloque.",
    "de": "Wie viel Claude Code du verbrauchst, laut ccusage: Limit-Fenster oder Ausgaben, Tokens nach Modell, Ausgaben pro Block.",
    "zh-Hant": "你用掉了多少 Claude Code，資料來自 ccusage：限制時段或花費、各模型的 token、每個區塊的花費。",
    "zh-Hans": "你消耗了多少 Claude Code，数据来自 ccusage：限额窗口或花费、各模型的 token、每个区块的花费。"
  },
  "author": "Kiosko",
  "license": "MIT",
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-usage#readme",
  "repository": "https://github.com/kiosko-lcd/kiosko-plugin-usage.git",
  "icon": "gauge",
  "sdk": "^0.2.0",
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "languages": [
    "en",
    "es",
    "de",
    "zh-Hant",
    "zh-Hans"
  ],
  "categories": [
    "agents"
  ],
  "tags": [
    "claude",
    "ccusage",
    "tokens",
    "cost",
    "sparkline"
  ],
  "permissions": {
    "exec": [
      "ccusage"
    ]
  },
  "riskyOptions": [
    {
      "path": "usage/ccusage: bin",
      "risk": [
        "exec"
      ],
      "secret": false
    }
  ],
  "requires": [],
  "optional": [],
  "widgets": [
    {
      "type": "usage/rail",
      "name": {
        "en": "Usage",
        "es": "Consumo",
        "de": "Nutzung",
        "zh-Hant": "用量",
        "zh-Hans": "用量"
      },
      "description": {
        "en": "Limit windows (or spend against your caps) as bars with their reset time, and today’s tokens by model.",
        "es": "Las ventanas de límite (o el gasto contra tus topes) en barras con su reinicio, y los tokens de hoy por modelo.",
        "de": "Limit-Fenster (oder Ausgaben gegen deine Obergrenzen) als Balken mit ihrer Reset-Zeit, und die heutigen Tokens nach Modell.",
        "zh-Hant": "以長條顯示各限制時段（或相對於上限的花費）及其重設時間，並列出今日各模型的 token。",
        "zh-Hans": "以进度条显示各限额窗口（或相对上限的花费）及其重置时间，并列出今日各模型的 token。"
      },
      "icon": "gauge",
      "category": "agents",
      "tags": [
        "claude",
        "ccusage",
        "tokens",
        "cost"
      ],
      "size": {
        "min": {
          "w": 220,
          "h": 200
        },
        "preferred": {
          "w": 380,
          "h": 390
        }
      },
      "chrome": "card",
      "sources": [
        "usage/ccusage"
      ],
      "options": {
        "default": {
          "bars": 2,
          "models": 3,
          "warn": 60,
          "alert": 85
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "bars": {
            "title": "Bars",
            "default": 2,
            "x-ui": {
              "label": {
                "en": "Bars",
                "es": "Barras",
                "de": "Balken",
                "zh-Hant": "長條數",
                "zh-Hans": "进度条数"
              }
            },
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "models": {
            "title": "Models listed",
            "description": "0 = only today's total.",
            "default": 3,
            "x-ui": {
              "label": {
                "en": "Models listed",
                "es": "Modelos listados",
                "de": "Aufgeführte Modelle",
                "zh-Hant": "列出的模型數",
                "zh-Hans": "列出的模型数"
              },
              "help": {
                "en": "0 = only today's total.",
                "es": "0 = solo el total de hoy.",
                "de": "0 = nur die heutige Summe.",
                "zh-Hant": "0 = 僅顯示今日總計。",
                "zh-Hans": "0 = 仅显示今日总计。"
              }
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "warn": {
            "title": "Amber from",
            "description": "How full a bar is.",
            "default": 60,
            "x-ui": {
              "label": {
                "en": "Amber from",
                "es": "Ámbar desde",
                "de": "Gelb ab",
                "zh-Hant": "琥珀色門檻",
                "zh-Hans": "琥珀色阈值"
              },
              "help": {
                "en": "How full a bar is.",
                "es": "Lo llena que está una barra.",
                "de": "Wie voll ein Balken ist.",
                "zh-Hant": "長條的填滿程度。",
                "zh-Hans": "进度条的填充程度。"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "alert": {
            "title": "Red from",
            "default": 85,
            "x-ui": {
              "label": {
                "en": "Red from",
                "es": "Rojo desde",
                "de": "Rot ab",
                "zh-Hant": "紅色門檻",
                "zh-Hans": "红色阈值"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "screenshot": "docs/rail.png",
      "animated": false,
      "urgent": false
    },
    {
      "type": "usage/blocks",
      "name": {
        "en": "Spend per 5-hour block",
        "es": "Gasto por bloque (5 h)",
        "de": "Ausgaben pro 5-Stunden-Block",
        "zh-Hant": "每 5 小時區塊的花費",
        "zh-Hans": "每 5 小时区块的花费"
      },
      "description": {
        "en": "The equivalent cost of the last 5-hour blocks (twelve by default), the running one highlighted: is today unusual?",
        "es": "El coste equivalente de los últimos bloques de 5 horas (doce por defecto), con el actual destacado: ¿hoy es un día raro?",
        "de": "Der Kostengegenwert der letzten 5-Stunden-Blöcke (standardmäßig zwölf), der laufende hervorgehoben: Ist heute ungewöhnlich?",
        "zh-Hant": "最近幾個 5 小時區塊（預設十二個）的等值成本，目前的區塊會醒目標示：今天是否異常？",
        "zh-Hans": "最近几个 5 小时区块（默认十二个）的等效成本，当前区块高亮显示：今天是否异常？"
      },
      "icon": "bar-chart",
      "category": "agents",
      "tags": [
        "claude",
        "ccusage",
        "cost",
        "sparkline"
      ],
      "size": {
        "min": {
          "w": 200,
          "h": 100
        },
        "preferred": {
          "w": 600,
          "h": 200
        }
      },
      "chrome": "card",
      "sources": [
        "usage/ccusage"
      ],
      "options": {
        "default": {
          "blocks": 12
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "blocks": {
            "title": "Blocks shown",
            "description": "12 = two and a half days; 48 = ten.",
            "default": 12,
            "x-ui": {
              "label": {
                "en": "Blocks shown",
                "es": "Bloques mostrados",
                "de": "Angezeigte Blöcke",
                "zh-Hant": "顯示的區塊數",
                "zh-Hans": "显示的区块数"
              },
              "help": {
                "en": "12 = two and a half days; 48 = ten.",
                "es": "12 = dos días y medio; 48 = diez.",
                "de": "12 = zweieinhalb Tage; 48 = zehn.",
                "zh-Hant": "12 = 兩天半；48 = 十天。",
                "zh-Hans": "12 = 两天半；48 = 十天。"
              }
            },
            "type": "integer",
            "minimum": 4,
            "maximum": 48
          }
        }
      },
      "screenshot": "docs/blocks.png",
      "animated": false,
      "urgent": false
    }
  ],
  "sources": [
    {
      "type": "usage/ccusage",
      "name": {
        "en": "Claude Code usage (ccusage)",
        "es": "Consumo de Claude Code (ccusage)",
        "de": "Claude-Code-Nutzung (ccusage)",
        "zh-Hant": "Claude Code 用量（ccusage）",
        "zh-Hans": "Claude Code 用量（ccusage）"
      },
      "description": {
        "en": "Runs ccusage, every minute by default and never more often. Each run walks the whole Claude Code history (a few seconds of CPU).",
        "es": "Ejecuta ccusage, cada minuto por defecto y nunca más a menudo. Cada pasada recorre todo el historial de Claude Code (unos segundos de CPU).",
        "de": "Führt ccusage aus, standardmäßig jede Minute und nie öfter. Jeder Lauf geht den gesamten Claude-Code-Verlauf durch (ein paar Sekunden CPU).",
        "zh-Hant": "執行 ccusage，預設每分鐘一次，且不會更頻繁。每次執行都會掃描完整的 Claude Code 歷史（耗費數秒 CPU）。",
        "zh-Hans": "运行 ccusage，默认每分钟一次，且不会更频繁。每次运行都会遍历完整的 Claude Code 历史（耗费几秒 CPU）。"
      },
      "polled": true,
      "intervalMs": 60000,
      "options": {
        "default": {
          "bin": "ccusage",
          "mode": "max",
          "dailyCap": 25,
          "monthlyCap": 400,
          "calibration": {
            "metric": "cost",
            "lookbackDays": 30,
            "percentile": 100
          }
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "bin": {
            "title": "ccusage command",
            "description": "Looked up in PATH unless it is a full path. May carry arguments, e.g. \"npx ccusage\".",
            "default": "ccusage",
            "x-ui": {
              "label": {
                "en": "ccusage command",
                "es": "Comando de ccusage",
                "de": "ccusage-Befehl",
                "zh-Hant": "ccusage 指令",
                "zh-Hans": "ccusage 命令"
              },
              "help": {
                "en": "Looked up in PATH unless it is a full path. May carry arguments, e.g. \"npx ccusage\".",
                "es": "Se busca en el PATH salvo que sea una ruta completa. Puede llevar argumentos, p. ej. \"npx ccusage\".",
                "de": "Wird im PATH gesucht, sofern es kein vollständiger Pfad ist. Darf Argumente enthalten, z. B. „npx ccusage“.",
                "zh-Hant": "除非是完整路徑，否則會在 PATH 中尋找。可帶參數，例如「npx ccusage」。",
                "zh-Hans": "除非是完整路径，否则在 PATH 中查找。可带参数，例如“npx ccusage”。"
              }
            },
            "x-risk": "exec",
            "type": "string"
          },
          "mode": {
            "title": "Plan",
            "default": "max",
            "x-ui": {
              "label": {
                "en": "Plan",
                "es": "Plan",
                "de": "Tarif",
                "zh-Hant": "方案",
                "zh-Hans": "套餐"
              },
              "labels": {
                "max": {
                  "en": "Subscription: limit windows",
                  "es": "Suscripción: ventanas de límite",
                  "de": "Abo: Limit-Fenster",
                  "zh-Hant": "訂閱：限制時段",
                  "zh-Hans": "订阅：限额窗口"
                },
                "api": {
                  "en": "API: spend against caps",
                  "es": "API: gasto contra topes",
                  "de": "API: Ausgaben gegen Obergrenzen",
                  "zh-Hant": "API：花費對照上限",
                  "zh-Hans": "API：花费对照上限"
                }
              }
            },
            "type": "string",
            "enum": [
              "max",
              "api"
            ]
          },
          "dailyCap": {
            "title": "Daily cap (API)",
            "default": 25,
            "x-ui": {
              "label": {
                "en": "Daily cap (API)",
                "es": "Tope diario (API)",
                "de": "Tageslimit (API)",
                "zh-Hant": "每日上限（API）",
                "zh-Hans": "每日上限（API）"
              },
              "unit": "USD",
              "step": 1
            },
            "type": "number",
            "minimum": 0
          },
          "monthlyCap": {
            "title": "Monthly cap (API)",
            "default": 400,
            "x-ui": {
              "label": {
                "en": "Monthly cap (API)",
                "es": "Tope mensual (API)",
                "de": "Monatslimit (API)",
                "zh-Hant": "每月上限（API）",
                "zh-Hans": "每月上限（API）"
              },
              "unit": "USD",
              "step": 10
            },
            "type": "number",
            "minimum": 0
          },
          "calibration": {
            "title": "Calibration (subscription)",
            "description": "ccusage doesn’t know your plan’s limit, so a full bar is your own busiest block or week.",
            "default": {
              "metric": "cost",
              "lookbackDays": 30,
              "percentile": 100
            },
            "x-ui": {
              "label": {
                "en": "Calibration (subscription)",
                "es": "Calibración (suscripción)",
                "de": "Kalibrierung (Abo)",
                "zh-Hant": "校準（訂閱）",
                "zh-Hans": "校准（订阅）"
              },
              "help": {
                "en": "ccusage doesn’t know your plan’s limit, so a full bar is your own busiest block or week.",
                "es": "ccusage no conoce el límite del plan, así que la barra llena es tu bloque o semana más cargados.",
                "de": "ccusage kennt das Limit deines Tarifs nicht, daher ist ein voller Balken dein eigener intensivster Block bzw. deine intensivste Woche.",
                "zh-Hant": "ccusage 不知道你方案的限額，因此滿格代表你自己用量最高的區塊或週。",
                "zh-Hans": "ccusage 不知道你套餐的限额，因此满条代表你自己用量最高的区块或周。"
              },
              "advanced": true
            },
            "type": "object",
            "properties": {
              "metric": {
                "title": "Measure",
                "default": "cost",
                "x-ui": {
                  "label": {
                    "en": "Measure",
                    "es": "Medida",
                    "de": "Maß",
                    "zh-Hant": "計量方式",
                    "zh-Hans": "计量方式"
                  },
                  "labels": {
                    "cost": {
                      "en": "Equivalent cost",
                      "es": "Coste equivalente",
                      "de": "Gegenwert in Kosten",
                      "zh-Hant": "等值成本",
                      "zh-Hans": "等效成本"
                    },
                    "tokens": {
                      "en": "Tokens",
                      "es": "Tokens",
                      "de": "Tokens",
                      "zh-Hant": "Token 數",
                      "zh-Hans": "Token 数"
                    }
                  }
                },
                "type": "string",
                "enum": [
                  "cost",
                  "tokens"
                ]
              },
              "lookbackDays": {
                "title": "Days of history (0 = all)",
                "default": 30,
                "x-ui": {
                  "label": {
                    "en": "Days of history (0 = all)",
                    "es": "Días de histórico (0 = todo)",
                    "de": "Tage Verlauf (0 = alle)",
                    "zh-Hant": "歷史天數（0 = 全部）",
                    "zh-Hans": "历史天数（0 = 全部）"
                  }
                },
                "type": "integer",
                "minimum": 0,
                "maximum": 365
              },
              "percentile": {
                "title": "Percentile that marks 100 %",
                "default": 100,
                "x-ui": {
                  "label": {
                    "en": "Percentile that marks 100 %",
                    "es": "Percentil que marca el 100 %",
                    "de": "Perzentil, das 100 % markiert",
                    "zh-Hant": "標示 100 % 的百分位數",
                    "zh-Hans": "标记 100 % 的百分位数"
                  },
                  "unit": "%",
                  "slider": true
                },
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  ],
  "interludes": [],
  "templates": [],
  "support": {
    "issues": "https://github.com/kiosko-lcd/kiosko-plugin-usage/issues",
    "docs": "https://github.com/kiosko-lcd/kiosko-plugin-usage#readme"
  }
}
